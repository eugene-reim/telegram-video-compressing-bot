BOT_TOKEN=123456:ABC-DEF...

# Optional limits & quality (uncomment to override defaults)
# MAX_DURATION_SECONDS=600          # 10 minutes – videos longer than this are ignored
# MAX_HEIGHT=720                    # max output height (keeps aspect ratio)
# CRF=28                            # constant rate factor (23 = high quality, 28 = good size, 32 = smaller)
# PRESET=medium                     # encoding speed vs compression efficiency
# AUDIO_BITRATE=128k
